rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      // Allow any authenticated user to read profiles (needed for discovery/team features)
      allow read: if isSignedIn();
      // Only the user can manage their own profile data
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /rooms/{roomId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      match /participants/{userId} {
        allow read, write: if isSignedIn();
      }

      match /messages/{msgId} {
        allow read, create: if isSignedIn();
      }

      match /signaling/{sigId} {
        allow read, create: if isSignedIn();
      }

      match /whiteboard/{pathId} {
        allow read, create: if isSignedIn();
      }
    }
    
    match /appointments/{appointmentId} {
      allow read, create: if isSignedIn();
      allow update: if isSignedIn();
    }
    
    match /doctors/{doctorId} {
      allow read: if isSignedIn();
    }
  }
}
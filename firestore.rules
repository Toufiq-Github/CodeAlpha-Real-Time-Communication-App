rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profiles: Publicly readable. 
    // allow create: Loosened to allow seeding and registration.
    match /users/{userId} {
      allow get, list: if true;
      allow create: if isSignedIn(); 
      allow update: if isOwner(userId);
    }

    // Posts: Publicly readable. 
    // allow create: Allow any signed-in user to create a post.
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn(); 
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid);
      }
    }

    // Follows: Publicly readable. Authenticated users can create/delete follow links.
    match /follows/{followId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;
    }
  }
}
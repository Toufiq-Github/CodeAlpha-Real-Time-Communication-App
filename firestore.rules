rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /rooms/{roomId} {
      // Allow read (get and list) for authenticated users to view session history
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      
      // Only the creator can manage the room metadata
      allow update, delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      match /participants/{userId} {
        allow read, write: if isSignedIn();
      }

      match /messages/{msgId} {
        allow read, create: if isSignedIn();
      }

      match /signaling/{sigId} {
        allow read, create: if isSignedIn();
      }

      match /whiteboard/{pathId} {
        allow read, create: if isSignedIn();
      }
    }
  }
}
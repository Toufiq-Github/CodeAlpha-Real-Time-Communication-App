{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's profile information, including their role.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The user's unique ID (matches auth UID)." },
        "name": { "type": "string", "description": "The user's full name." },
        "email": { "type": "string", "format": "email", "description": "The user's email address." },
        "role": { "type": "string", "enum": ["Patient", "Doctor", "Admin"], "description": "The user's role in the system." }
      },
      "required": ["id", "name", "email", "role"]
    },
    "DoctorProfile": {
      "title": "Doctor Profile",
      "description": "Publicly accessible information about a doctor.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The UID of the user this profile belongs to." },
        "name": { "type": "string" },
        "specialty": { "type": "string" },
        "email": { "type": "string", "format": "email" }
      },
      "required": ["userId", "name", "specialty", "email"]
    },
    "Hospital": {
        "title": "Hospital",
        "description": "Information about a hospital or clinic.",
        "type": "object",
        "properties": {
            "name": { "type": "string" },
            "address": { "type": "string" }
        },
        "required": ["name"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Represents a scheduled appointment between a patient and a doctor.",
      "type": "object",
      "properties": {
        "patientUserId": { "type": "string" },
        "doctorUserId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["Pending", "Accepted", "Rejected"] },
        "meetLink": { "type": "string", "format": "uri" }
      },
      "required": ["patientUserId", "doctorUserId", "date", "status"]
    },
    "MedicalImage": {
        "title": "Medical Image",
        "description": "A medical image uploaded by a doctor for a patient.",
        "type": "object",
        "properties": {
            "patientUserId": { "type": "string" },
            "doctorUserId": { "type": "string" },
            "imageUrl": { "type": "string", "format": "uri" },
            "uploadedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["patientUserId", "doctorUserId", "imageUrl", "uploadedAt"]
    },
    "SymptomReport": {
        "title": "Symptom Report",
        "description": "A private symptom report generated by a patient.",
        "type": "object",
        "properties": {
            "patientUserId": { "type": "string" },
            "symptoms": { "type": "string" },
            "report": { "type": "object" },
            "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["patientUserId", "symptoms", "createdAt"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profiles for all user types."
    },
    "/doctors/{doctorId}": {
      "schema": { "$ref": "#/entities/DoctorProfile" },
      "description": "Public profiles for doctors."
    },
    "/hospitals/{hospitalId}": {
      "schema": { "$ref": "#/entities/Hospital" },
      "description": "Public information about hospitals."
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Appointments shared between a patient and a doctor."
    },
    "/medicalImages/{medicalImageId}": {
        "schema": { "$ref": "#/entities/MedicalImage" },
        "description": "Medical images shared between a patient and a doctor."
    },
    "/symptomReports/{symptomReportId}": {
        "schema": { "$ref": "#/entities/SymptomReport" },
        "description": "Private symptom reports for patients."
    }
  }
}

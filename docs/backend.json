
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "General profile information for a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "avatarUrl": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "createdAt"]
    },
    "Room": {
      "title": "Room",
      "description": "A virtual meeting room.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isActive": { "type": "boolean", "default": true },
        "summary": { "type": "string", "description": "AI-generated summary of the session." }
      },
      "required": ["name", "createdBy", "createdAt"]
    },
    "Participant": {
      "title": "Participant",
      "description": "A user in a meeting room.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "joinedAt": { "type": "string", "format": "date-time" },
        "isCameraOn": { "type": "boolean", "default": false },
        "isMicOn": { "type": "boolean", "default": false }
      }
    },
    "SignalingMessage": {
      "title": "Signaling Message",
      "description": "WebRTC signaling data (offer, answer, ice-candidate).",
      "type": "object",
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "type": { "type": "string", "enum": ["offer", "answer", "candidate"] },
        "data": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A message sent in the room chat.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "WhiteboardPath": {
      "title": "Whiteboard Path",
      "description": "A drawing path on the whiteboard.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "color": { "type": "string" },
        "points": { "type": "array", "items": { "type": "object" } },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles."
    },
    "/rooms/{roomId}": {
      "schema": { "$ref": "#/entities/Room" },
      "description": "Main room metadata."
    },
    "/rooms/{roomId}/participants/{userId}": {
      "schema": { "$ref": "#/entities/Participant" },
      "description": "List of active participants."
    },
    "/rooms/{roomId}/messages/{msgId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "In-room chat messages."
    },
    "/rooms/{roomId}/signaling/{sigId}": {
      "schema": { "$ref": "#/entities/SignalingMessage" },
      "description": "WebRTC signaling messages."
    },
    "/rooms/{roomId}/whiteboard/{pathId}": {
      "schema": { "$ref": "#/entities/WhiteboardPath" },
      "description": "Shared whiteboard paths."
    }
  }
}
